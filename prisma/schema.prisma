// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String?         @unique
  phone          String?         @unique
  password       String
  role           Role            @default(USER)
  name           String?
  verified       Boolean         @default(false)
  changeRequests ChangeRequest[] @relation("ChangeRequester")
  familiesOwner  Family[]
  familyTrees    FamilyTree[]
  subscribtion   Subscribtion    @default(TRIAL)
  recordsCount   Int             @default(0)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   
  token      String   @unique
  expires    DateTime
}


enum Role {
  ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
}

enum Subscribtion {
  TRIAL
  PRO
}

model Person {
  id         String          @id @default(uuid()) @db.Uuid
  firstName  String
  fullName   String
  gender     Gender
  kunya      String? 
  birthDate  DateTime?
  deathDate  DateTime?
  phone      String?

  isDead     Boolean         @default(false)
  
  family     Family    @relation("FamilyMembers", fields: [familyId], references: [id])
  familyId   String @db.Uuid

  fatherId String? @db.Uuid
  motherId String? @db.Uuid

  father Person? @relation("FatherRelation", fields: [fatherId], references: [id])
  mother Person? @relation("MotherRelation", fields: [motherId], references: [id])

  fatherChildren Person[] @relation("FatherRelation")
  motherChildren Person[] @relation("MotherRelation")

  maleSpouses    SpouseRelationship[] @relation("Males")
  femaleSpouses  SpouseRelationship[] @relation("Females")

  rootOfTree        FamilyTree[]                @relation("RootOfTree")
  collapsedInTrees  FamilyTreeCollapsedBranch[]
}

model SpouseRelationship {
  id       String @id @default(uuid()) @db.Uuid
  male     Person @relation("Males", fields: [maleId], references: [id], onDelete: Cascade)
  maleId   String @db.Uuid
  female   Person @relation("Females", fields: [femaleId], references: [id], onDelete: Cascade)
  femaleId String @db.Uuid

  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)

  @@unique([maleId, femaleId])
}

enum ChangeRequestAction {
  ADD
  DELETE
  UPDATE
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChangeRequestTargetModel {
  PERSON
  SPOUSERELATIONSHIP
}

model ChangeRequest {
  id             String              @id @default(uuid()) @db.Uuid
  displayId      Int                 @default(autoincrement())
  action         ChangeRequestAction
  status         ChangeRequestStatus @default(PENDING)
  targetModel    ChangeRequestTargetModel
  targetId       String? @db.Uuid
  data           Json?
  requester      User?               @relation("ChangeRequester", fields: [requesterId], references: [id])
  requesterId    String? @db.Uuid
  requesterName  String?
  requesterPhone String?
  createdAt      DateTime            @default(now())
}

model Family {
  id      String   @id @default(uuid()) @db.Uuid
  name    String
  owner   User?    @relation(fields: [ownerId], references: [id])
  ownerId String?  @db.Uuid
  members Person[] @relation("FamilyMembers")
}

model FamilyTree {
  id                String                      @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  rootPerson        Person                      @relation("RootOfTree", fields: [rootPersonId], references: [id])
  rootPersonId      String                      @db.Uuid
  owner             User                        @relation(fields: [ownerId], references: [id])
  ownerId           String                      @db.Uuid
  treeJson          Json?
  membersCount      Int                         @default(0)
  collapsedBranches FamilyTreeCollapsedBranch[]
  createdAt         DateTime                    @default(now())
}

// Person whose children/subtree are hidden in this tree.
// The person node itself stays visible; only their descendants are hidden.
model FamilyTreeCollapsedBranch {
  tree      FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  treeId    String     @db.Uuid
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String     @db.Uuid
  @@id([treeId, personId])
}